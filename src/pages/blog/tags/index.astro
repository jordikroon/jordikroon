---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base
  title="Tags"
  description="All tags used across the writing on jordikroon.nl."
>
  <section class="container-wide pt-20">
    <p class="eyebrow">Tags</p>
    <h1 class="display mt-4 text-[clamp(2rem,5vw,3.25rem)]">All <em>tags</em></h1>

    <ul class="mt-10 flex flex-wrap gap-2">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={`/blog/tags/${tag}`} class="tag">
              #{tag}
              <span class="text-[var(--color-subtle)]">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
