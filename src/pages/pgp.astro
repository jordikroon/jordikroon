---
import Base from '@/layouts/Base.astro';
import { SITE } from '@/site.config';
import Email from '@/components/Email.astro';

const PGP = {
  fingerprint: 'A9B4 838D 85CA A4A3 3C63  EF1C F01C 571B F014 5C48',
  keyId: 'F01C571BF0145C48',
  algorithm: 'RSA 4096 / SHA-2',
  created: '2025-12-25',
  expires: '2028-12-24',
  uids: [
    'jordi@jordikroon.nl',
    'jordikroon@me.com',
    'jkroon@onyourmarks.agency',
    'hosting@onyourmarks.agency',
  ],
};
---

<Base
  title="PGP"
  description="Public PGP key for verifying signed commits and encrypted communication with Jordi Kroon."
>
  <section class="container-prose pt-20">
    <p class="eyebrow">PGP</p>
    <h1 class="display mt-4 text-[clamp(2rem,5vw,3.25rem)]">
      <em>Verify</em> me, encrypt to me.
    </h1>
    <p class="mt-5 text-[var(--color-muted)] text-balance">
      Use this key to send me encrypted email or verify signatures on commits, releases, and
      messages.
    </p>

    <dl class="mt-10 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-3 font-mono text-sm">
      <dt class="text-[var(--color-muted)]">name</dt>
      <dd>{SITE.author}</dd>
      <dt class="text-[var(--color-muted)]">primary</dt>
      <dd><Email class="link-underline" /></dd>
      <dt class="text-[var(--color-muted)]">key id</dt>
      <dd class="break-all">{PGP.keyId}</dd>
      <dt class="text-[var(--color-muted)]">fingerprint</dt>
      <dd class="break-all">{PGP.fingerprint}</dd>
      <dt class="text-[var(--color-muted)]">algorithm</dt>
      <dd>{PGP.algorithm}</dd>
      <dt class="text-[var(--color-muted)]">created</dt>
      <dd>{PGP.created}</dd>
      <dt class="text-[var(--color-muted)]">expires</dt>
      <dd>{PGP.expires}</dd>
      <dt class="text-[var(--color-muted)] pt-1">signs for</dt>
      <dd>
        <ul class="space-y-1">
          {
            PGP.uids.map((uid) => {
              const [user, domain] = uid.split('@');
              return (
                <li>
                  {user} <span aria-hidden="true">[at]</span> {domain}
                </li>
              );
            })
          }
        </ul>
      </dd>
    </dl>

    <div class="mt-10 flex flex-wrap gap-3 font-mono text-sm">
      <a
        href="/pgp.asc"
        class="rounded-full border border-[var(--color-line)] px-4 py-2 transition-colors hover:border-[var(--color-fg)]"
        download
      >
        download public key (.asc)
      </a>
      <a
        href={`https://keys.openpgp.org/search?q=${PGP.fingerprint.replace(/\s+/g, '')}`}
        rel="noopener"
        class="rounded-full border border-[var(--color-line)] px-4 py-2 transition-colors hover:border-[var(--color-fg)]"
      >
        lookup on keys.openpgp.org
      </a>
    </div>

    <h2 class="mt-14 eyebrow not-italic">Quick import</h2>
    <pre class="mt-3"><code>{`curl -sSL ${SITE.url}/pgp.asc | gpg --import`}</code></pre>

    <p class="mt-3 text-sm text-[var(--color-muted)]">
      Or pull it straight from the keyserver:
    </p>
    <pre class="mt-3"><code>{`gpg --keyserver hkps://keys.openpgp.org --recv-keys ${PGP.keyId}`}</code></pre>

    <p class="mt-10 text-sm text-[var(--color-muted)]">
      Never used PGP before? See
      <a class="link-underline" href="https://www.openpgp.org/" rel="noopener">openpgp.org</a>
      for a getting-started guide.
    </p>
  </section>
</Base>
