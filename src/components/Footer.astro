---
import { SITE, SOCIAL, BUILD } from '@/site.config';

const year = new Date().getFullYear();
const builtAt = BUILD.builtAt.slice(0, 10);
---

<footer class="border-t border-[var(--color-line)] mt-12 py-10 font-mono text-xs text-[var(--color-muted)]">
  <div class="mx-auto grid w-full max-w-6xl gap-y-6 px-6 sm:grid-cols-3 sm:items-center sm:gap-x-8">
    <p class="sm:col-span-1">
      © {year} {SITE.author}
      <span class="text-[var(--color-subtle)]"> · MIT / CC BY 4.0</span>
    </p>

    <p class="sm:col-span-1 sm:text-center">
      <span class="text-[var(--color-positive)]">HTTP/2 200</span>
      <span class="text-[var(--color-subtle)]"> · </span>
      <time datetime={BUILD.builtAt}>{builtAt}</time>
      <span class="text-[var(--color-subtle)]"> · </span>
      <span class="text-[var(--color-fg)]">{BUILD.sha}</span>
      <span class="text-[var(--color-subtle)]"> · gh-pages</span>
    </p>

    <ul class="flex flex-wrap gap-x-4 gap-y-2 sm:col-span-1 sm:justify-end">
      <li><a class="link-underline" href={SOCIAL.github} rel="me noopener">github</a></li>
      <li><a class="link-underline" href={SOCIAL.linkedin} rel="me noopener">linkedin</a></li>
      <li><a class="link-underline" href={SOCIAL.mastodon} rel="me noopener">mastodon</a></li>
      <li><a class="link-underline" href={SOCIAL.rss}>rss</a></li>
      <li><a class="link-underline" href="/pgp">pgp</a></li>
    </ul>
  </div>
</footer>
